<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MKNote.App.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MKNote Next">

    <Grid x:Name="ShellRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="46" />
            <RowDefinition Height="*" />
            <RowDefinition Height="26" />
        </Grid.RowDefinitions>

        <!-- ==================== Minimal Clean Top Bar ==================== -->
        <Grid Grid.Row="0" Padding="10,0,12,0" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left: Collapse Nav + Primary New Note -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button x:Name="ToggleNavBtn" Click="ToggleSidebar_Click" Background="Transparent" BorderThickness="0" Padding="8,6" ToolTipService.ToolTip="展开 / 收起左侧边栏">
                    <FontIcon Glyph="&#xE700;" FontSize="14" />
                </Button>

                <SplitButton x:Name="NewNoteSplitBtn" Click="NewDefaultNote_Click" ToolTipService.ToolTip="新建笔记（支持 Markdown / 富文本 / 模板）">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE710;" FontSize="13" />
                        <TextBlock x:Name="NewNoteBtnText" Text="新建" FontWeight="SemiBold" FontSize="13" />
                    </StackPanel>
                    <SplitButton.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:Name="MenuNewMd" Text="新建 Markdown 笔记" Click="NewMarkdownNote_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="MenuNewRich" Text="新建富文本笔记" Click="NewRichNote_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutSubItem x:Name="TemplatesMenu" Text="从模板新建...">
                                <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE8F1;" /></MenuFlyoutSubItem.Icon>
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="MenuNewSticky" Text="新建桌面便签" Click="NewStickyNote_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70B;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </SplitButton.Flyout>
                </SplitButton>
            </StackPanel>

            <!-- Center: Full-Vault Exact Symbol & Text Search -->
            <AutoSuggestBox x:Name="SearchBox"
                            Grid.Column="1"
                            MaxWidth="420"
                            MinWidth="220"
                            HorizontalAlignment="Center"
                            PlaceholderText="搜索全部文档（支持符号、双链与标签）(Ctrl+K)"
                            QueryIcon="Find"
                            TextChanged="SearchBox_TextChanged"
                            VerticalAlignment="Center" />

            <!-- Right: Quiet Essential Actions + Clean Overflow Menu -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                <Button x:Name="CaptureBtn" Click="CaptureScreen_Click" Background="Transparent" BorderThickness="0" Padding="8,6" ToolTipService.ToolTip="截图并加密插入 (Ctrl+Shift+A)">
                    <FontIcon Glyph="&#xE722;" FontSize="15" />
                </Button>

                <Button x:Name="InsertImgBtn" Click="InsertLocalImage_Click" Background="Transparent" BorderThickness="0" Padding="8,6" ToolTipService.ToolTip="插入本地图片（加密存库）">
                    <FontIcon Glyph="&#xEB9F;" FontSize="15" />
                </Button>

                <!-- Document Background Color & Paper Texture -->
                <Button x:Name="BgColorBtn" Background="Transparent" BorderThickness="0" Padding="8,6" ToolTipService.ToolTip="文档背景色与纹理">
                    <Border x:Name="BgColorSwatch" Width="16" Height="16" CornerRadius="8" BorderThickness="1.5" BorderBrush="{ThemeResource TextFillColorSecondaryBrush}" Background="#FFFFFF" />
                    <Button.Flyout>
                        <Flyout x:Name="BgColorFlyout">
                            <StackPanel Width="280" Spacing="10">
                                <TextBlock Text="文档背景色" FontWeight="SemiBold" FontSize="13" />
                                <GridView x:Name="BgPresetGrid" SelectionMode="None" IsItemClickEnabled="True" ItemClick="BgPresetGrid_ItemClick">
                                    <GridView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Width="62" Spacing="3" Padding="2">
                                                <Border Width="40" Height="26" CornerRadius="6" BorderThickness="1" BorderBrush="#40808080" Background="{Binding LightHex}" />
                                                <TextBlock Text="{Binding Name}" FontSize="10.5" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </GridView.ItemTemplate>
                                </GridView>

                                <TextBlock Text="纸张纹理" FontWeight="SemiBold" FontSize="13" Margin="0,2,0,0" />
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="纯色" Tag="Solid" Click="BgStyle_Click" Padding="8,4" FontSize="12" />
                                    <Button Content="横线" Tag="Lined" Click="BgStyle_Click" Padding="8,4" FontSize="12" />
                                    <Button Content="方格" Tag="Grid" Click="BgStyle_Click" Padding="8,4" FontSize="12" />
                                    <Button Content="点阵" Tag="Dot" Click="BgStyle_Click" Padding="8,4" FontSize="12" />
                                    <Button Content="纸感" Tag="Paper" Click="BgStyle_Click" Padding="8,4" FontSize="12" />
                                </StackPanel>

                                <Expander Header="自定义颜色" HorizontalAlignment="Stretch">
                                    <StackPanel Spacing="8" Padding="0,6,0,0">
                                        <ColorPicker x:Name="CustomBgColorPicker" IsAlphaEnabled="False" ColorSpectrumShape="Ring" />
                                        <Button Content="应用背景色" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="ApplyCustomBgColor_Click" />
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>

                <!-- Toggle Right Info Drawer -->
                <ToggleButton x:Name="RightPanelToggle" IsChecked="False" Click="RightPanelToggle_Click" Background="Transparent" BorderThickness="0" Padding="8,6" ToolTipService.ToolTip="大纲、反向链接与附件">
                    <FontIcon Glyph="&#xE8FD;" FontSize="15" />
                </ToggleButton>

                <!-- Unified Clean Overflow Menu (...) -->
                <Button x:Name="MoreMenuBtn" Background="Transparent" BorderThickness="0" Padding="8,6" ToolTipService.ToolTip="更多功能与设置">
                    <FontIcon Glyph="&#xE712;" FontSize="15" />
                    <Button.Flyout>
                        <MenuFlyout>
                            <MenuFlyoutItem x:Name="MenuSyncItem" Text="加密同步（群晖 NAS / WebDAV）..." Click="OpenSyncWindow_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE895;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="MenuVimGuideItem" Text="Vim 快捷键指南与自定义..." Click="OpenVimShortcuts_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE765;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="MenuMdGuideItem" Text="Markdown 语法与快捷键指南..." Click="OpenMarkdownGuide_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="EncryptMenuItem" Text="为当前笔记加密/解密..." Click="ToggleNoteEncryption_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72E;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="MenuStickyCurrentItem" Text="弹出为独立便签窗" Click="OpenCurrentAsSticky_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A7;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="MenuHistoryItem" Text="历史版本回溯..." Click="ShowRevisions_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE81C;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="MenuGraphItem" Text="知识图谱" Click="OpenGraphView_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE9D9;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutSubItem x:Name="MenuThemeSub" Text="界面主题">
                                <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE790;" /></MenuFlyoutSubItem.Icon>
                                <MenuFlyoutItem Text="跟随系统 / System" Tag="System" Click="AppTheme_Click" />
                                <MenuFlyoutItem Text="浅色模式 / Light" Tag="Light" Click="AppTheme_Click" />
                                <MenuFlyoutItem Text="深色模式 / Dark" Tag="Dark" Click="AppTheme_Click" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSubItem x:Name="MenuBackupSub" Text="备份与导入导出">
                                <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutSubItem.Icon>
                                <MenuFlyoutItem x:Name="MenuBackupItem" Text="创建加密备份 (.mkbackup)" Click="CreateBackup_Click" />
                                <MenuFlyoutItem Text="打开数据文件夹" Click="OpenVaultFolder_Click" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="MenuImportObsItem" Text="导入 Markdown 文件夹..." Click="ImportMarkdownFolder_Click" />
                                <MenuFlyoutItem x:Name="MenuImportMknoteItem" Text="导入单文件归档 (.mknote)..." Click="ImportMknoteFile_Click" />
                                <MenuFlyoutItem x:Name="MenuImportLegacyItem" Text="导入本地 SQLite 数据库 (.db)..." Click="ImportLegacyDb_Click" />
                                <MenuFlyoutItem x:Name="MenuImportHtmlFolderItem" Text="导入网页 HTML 文件夹..." Click="ImportHtmlFolder_Click" />
                                <MenuFlyoutItem x:Name="MenuExportObsItem" Text="导出为 Markdown 文件夹..." Click="ExportMarkdownFolder_Click" />
                            </MenuFlyoutSubItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="MenuLockItem" Text="立即锁定应用" Click="LockAppNow_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72E;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="MenuAppLockCfgItem" Text="应用锁与 Windows Hello..." Click="ConfigureAppLock_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8D7;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutItem x:Name="MenuSettingsItem" Text="偏好设置..." Click="OpenPreferences_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE713;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem x:Name="MenuExitItem" Text="彻底退出" Click="ForceExitApp_Click">
                                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7E8;" /></MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ==================== Calm 3-Pane Workspace ==================== -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavCol" Width="206" />
                <ColumnDefinition x:Name="ListCol" Width="264" />
                <ColumnDefinition Width="*" MinWidth="380" />
                <ColumnDefinition x:Name="InspectorCol" Width="0" />
            </Grid.ColumnDefinitions>

            <!-- Pane 1: Quiet Left Sidebar -->
            <Grid x:Name="NavPane" Grid.Column="0" Background="{ThemeResource LayerFillColorAltBrush}" BorderThickness="0,0,1,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel Padding="8,10" Spacing="4">
                        <ListView x:Name="QuickNavList" SelectionMode="Single" SelectedIndex="0" SelectionChanged="QuickNavList_SelectionChanged">
                            <ListViewItem Tag="all">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE8F1;" FontSize="14" Opacity="0.75" />
                                    <TextBlock x:Name="NavAllText" Text="全部笔记" FontSize="13" />
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem Tag="starred">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE734;" FontSize="14" Opacity="0.75" />
                                    <TextBlock x:Name="NavStarredText" Text="星标收藏" FontSize="13" />
                                </StackPanel>
                            </ListViewItem>
                            <ListViewItem Tag="trash">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14" Opacity="0.75" />
                                    <TextBlock x:Name="NavTrashText" Text="回收站" FontSize="13" />
                                </StackPanel>
                            </ListViewItem>
                        </ListView>

                        <Grid Margin="10,14,4,2">
                            <TextBlock x:Name="SectionNotebooksText" Text="笔记本" FontSize="11.5" FontWeight="SemiBold" Opacity="0.55" VerticalAlignment="Center" />
                            <Button x:Name="AddCatBtn" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0" Padding="5,2" Click="AddCategory_Click" ToolTipService.ToolTip="新建笔记本">
                                <FontIcon Glyph="&#xE710;" FontSize="11" />
                            </Button>
                        </Grid>

                        <!-- Notebooks / Folders List: Full Right-Click & Inline Action Menu (Delete/Rename ANY folder incl. defaults!) -->
                        <ListView x:Name="CategoryList" SelectionMode="Single" SelectionChanged="CategoryList_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="2,4" Background="Transparent">
                                        <Grid.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="重命名笔记本" Tag="{Binding}" Click="RenameCategory_Click">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AC;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="新建子笔记本" Tag="{Binding}" Click="AddSubCategory_Click">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8F4;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="删除笔记本" Tag="{Binding}" Click="DeleteCategory_Click">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Grid.ContextFlyout>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DisplayName}" FontSize="13" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding NoteCount}" FontSize="11" Opacity="0.45" Margin="4,0,2,0" VerticalAlignment="Center" />
                                        <Button Grid.Column="2" Background="Transparent" BorderThickness="0" Padding="4,1" Opacity="0.6" ToolTipService.ToolTip="重命名 / 删除笔记本">
                                            <FontIcon Glyph="&#xE712;" FontSize="11" />
                                            <Button.Flyout>
                                                <MenuFlyout>
                                                    <MenuFlyoutItem Text="重命名笔记本" Tag="{Binding}" Click="RenameCategory_Click">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8AC;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutItem Text="新建子笔记本" Tag="{Binding}" Click="AddSubCategory_Click">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8F4;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Text="删除笔记本" Tag="{Binding}" Click="DeleteCategory_Click">
                                                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                                    </MenuFlyoutItem>
                                                </MenuFlyout>
                                            </Button.Flyout>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <TextBlock x:Name="SectionTagsText" Text="标签" FontSize="11.5" FontWeight="SemiBold" Opacity="0.55" Margin="10,14,0,2" />
                        <ListView x:Name="TagList" SelectionMode="Single" SelectionChanged="TagList_SelectionChanged">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="2,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Name}" FontSize="12.5" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="1" Text="{Binding NoteCount}" FontSize="11" Opacity="0.45" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>

                <!-- Quiet Sidebar Footer: Graph & Settings -->
                <Grid Grid.Row="1" Padding="8,6" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0" Click="OpenGraphView_Click" Padding="6,6" ToolTipService.ToolTip="知识图谱">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE9D9;" FontSize="13" Opacity="0.75" />
                            <TextBlock x:Name="FooterGraphText" Text="知识图谱" FontSize="12" Opacity="0.8" />
                        </StackPanel>
                    </Button>
                    <Button Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" BorderThickness="0" Click="OpenPreferences_Click" Padding="6,6" ToolTipService.ToolTip="偏好设置">
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE713;" FontSize="13" Opacity="0.75" />
                            <TextBlock x:Name="FooterSettingsText" Text="设置" FontSize="12" Opacity="0.8" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>

            <!-- Pane 2: Clean Note List -->
            <Grid x:Name="NoteListPane" Grid.Column="1" BorderThickness="0,0,1,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="38" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Padding="10,4" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <TextBlock x:Name="ListHeaderText" Text="全部笔记" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12.5" Opacity="0.8" TextTrimming="CharacterEllipsis" Margin="0,0,126,0" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="1" VerticalAlignment="Center">
                        <Button x:Name="FilterAllBtn" Content="全部" Tag="all" Click="FormatFilter_Click" Background="Transparent" BorderThickness="0" Padding="5,2" FontSize="11" />
                        <Button x:Name="FilterMdBtn" Content="MD" Tag="md" Click="FormatFilter_Click" Background="Transparent" BorderThickness="0" Padding="5,2" FontSize="11" Opacity="0.65" />
                        <Button x:Name="FilterRichBtn" Content="富文本" Tag="rich" Click="FormatFilter_Click" Background="Transparent" BorderThickness="0" Padding="5,2" FontSize="11" Opacity="0.65" />
                        <Button x:Name="EmptyTrashBtn" Content="清空" Visibility="Collapsed" Click="EmptyTrash_Click" Padding="5,2" FontSize="11" />
                        <ToggleButton x:Name="MultiSelectToggleBtn" Click="MultiSelectToggle_Click" Background="Transparent" BorderThickness="0" Padding="6,3" ToolTipService.ToolTip="批量多选与删除">
                            <FontIcon Glyph="&#xE762;" FontSize="12.5" />
                        </ToggleButton>
                    </StackPanel>
                </Grid>

                <!-- 批量多选操作栏（全选 / 反选 / 批量删除 / 回收站批量恢复） -->
                <Border x:Name="BatchActionBar" Grid.Row="1" Visibility="Collapsed" Padding="10,6" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Background="{ThemeResource LayerFillColorAltBrush}">
                    <StackPanel Spacing="6">
                        <Grid>
                            <TextBlock x:Name="BatchSelectionCountText" Text="已选 0 篇" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="4">
                                <Button x:Name="BatchSelectAllBtn" Content="全选" Click="SelectAllNotes_Click" Padding="7,2" FontSize="11.5" />
                                <Button x:Name="BatchInvertBtn" Content="反选" Click="InvertNoteSelection_Click" Padding="7,2" FontSize="11.5" />
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Button x:Name="BatchRestoreBtn" Content="恢复所选" Visibility="Collapsed" IsEnabled="False" Click="BatchRestoreNotes_Click" Padding="8,3" FontSize="11.5" HorizontalAlignment="Left" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                                <Button x:Name="BatchDeleteBtn" Content="删除所选" IsEnabled="False" Click="BatchDeleteNotes_Click" Padding="8,3" FontSize="11.5" Foreground="IndianRed" />
                                <Button x:Name="BatchCancelBtn" Content="完成" Click="ExitMultiSelect_Click" Padding="8,3" FontSize="11.5" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <ListView x:Name="NoteListView" Grid.Row="2" Padding="4,4" SelectionMode="Single" SelectionChanged="NoteListView_SelectionChanged">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="6,9" RowSpacing="4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="{Binding FormatBadge}" FontSize="10" Opacity="0.45" Margin="6,2,0,0" />
                                </Grid>
                                <TextBlock Grid.Row="1" Text="{Binding SummaryPreview}" FontSize="12" Opacity="0.58" MaxLines="1" TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding UpdatedDisplay}" FontSize="10.5" Opacity="0.45" />
                                    <TextBlock Text="{Binding TagsDisplay}" FontSize="10.5" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Opacity="0.8" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>

            <!-- Pane 3: Spacious Writing Canvas -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Unified Note Header Bar (Identical Copy/Move/Pin/Star/Delete + Interactive Tag Chips for BOTH Rich Text & Markdown!) -->
                <StackPanel x:Name="NoteHeaderBar" Grid.Row="0" Padding="24,10,16,6" Spacing="4" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="NoteTitleBox"
                                 Grid.Column="0"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 FontSize="20"
                                 FontWeight="SemiBold"
                                 PlaceholderText="无标题笔记"
                                 LostFocus="NoteTitleBox_LostFocus" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <Button x:Name="CopyNoteToBtn" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="复制到其他笔记本" Click="CopyNoteTo_Click" Padding="7,5">
                                <FontIcon Glyph="&#xE8C8;" FontSize="13" />
                            </Button>
                            <Button x:Name="MoveNoteToBtn" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="移动到其他笔记本" Click="MoveNoteTo_Click" Padding="7,5">
                                <FontIcon Glyph="&#xE8DE;" FontSize="13" />
                            </Button>
                            <ToggleButton x:Name="PinNoteToggle" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="置顶" Click="PinNoteToggle_Click" Padding="7,5">
                                <FontIcon Glyph="&#xE718;" FontSize="13" />
                            </ToggleButton>
                            <ToggleButton x:Name="StarNoteToggle" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="星标收藏" Click="StarNoteToggle_Click" Padding="7,5">
                                <FontIcon Glyph="&#xE734;" FontSize="13" />
                            </ToggleButton>
                            <Button x:Name="DeleteNoteBtn" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="移入回收站" Click="DeleteNote_Click" Padding="7,5">
                                <FontIcon Glyph="&#xE74D;" FontSize="13" />
                            </Button>
                            <Button x:Name="RestoreNoteBtn" Content="恢复" Visibility="Collapsed" Click="RestoreNote_Click" Padding="8,4" FontSize="12" />
                        </StackPanel>
                    </Grid>

                    <!-- Interactive Tag Chips Row (Works on BOTH Rich Text and Markdown!) -->
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <StackPanel x:Name="NoteTagsPanel" Orientation="Horizontal" Spacing="6" />
                        <Button x:Name="AddNoteTagBtn" Content="+ 标签" Click="AddTagToNote_Click" Padding="7,1" FontSize="11.5" Background="Transparent" BorderThickness="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" CornerRadius="10" Opacity="0.75" />
                    </StackPanel>
                </StackPanel>

                <!-- WebView2 Dual-Engine Editor -->
                <WebView2 x:Name="EditorWebView" Grid.Row="1" />

                <!-- Empty State Overlay (Shown immediately when Trash is emptied or no note selected) -->
                <Grid x:Name="EmptyStateGate" Grid.Row="1" Visibility="Collapsed" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                        <FontIcon Glyph="&#xE70F;" FontSize="32" Opacity="0.3" HorizontalAlignment="Center" />
                        <TextBlock x:Name="EmptyStateHintText" Text="请选择一篇笔记，或点击左上角「新建」开始写作" FontSize="13.5" Opacity="0.55" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Trash Privacy Gate (Deleted notes CANNOT be viewed directly until restored!) -->
                <Grid x:Name="TrashBlockedGate" Grid.Row="1" Visibility="Collapsed" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="360" Spacing="12" Padding="26" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <FontIcon Glyph="&#xE74D;" FontSize="28" Opacity="0.7" HorizontalAlignment="Center" />
                        <TextBlock x:Name="TrashBlockedTitleText" Text="此笔记位于回收站中" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock x:Name="TrashBlockedDescText" Text="已删除的文档默认禁止直接查看。您可以先恢复到笔记本，或彻底删除。" FontSize="12.5" Opacity="0.68" TextWrapping="Wrap" TextAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center" Margin="0,6,0,0">
                            <Button x:Name="TrashRestoreGateBtn" Content="恢复此笔记" Style="{StaticResource AccentButtonStyle}" Click="RestoreNote_Click" />
                            <Button x:Name="TrashPermDeleteGateBtn" Content="彻底删除" Click="DeleteNote_Click" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- Per-Note Encrypted Unlock Gate -->
                <Grid x:Name="NoteLockGate" Grid.Row="1" Visibility="Collapsed" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="320" Spacing="12" Padding="24" CornerRadius="12" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                        <FontIcon Glyph="&#xE72E;" FontSize="26" HorizontalAlignment="Center" />
                        <TextBlock Text="此笔记已加密" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock x:Name="NoteLockHintText" Text="密码提示：无" FontSize="12" Opacity="0.65" HorizontalAlignment="Center" />
                        <PasswordBox x:Name="NoteUnlockPwdBox" PlaceholderText="输入解密密码" />
                        <Button Content="解锁笔记" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="UnlockEncryptedNote_Click" />
                        <TextBlock x:Name="NoteUnlockErrorText" Foreground="IndianRed" FontSize="12" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Pane 4: On-Demand Right Drawer -->
            <Grid x:Name="InspectorPane" Grid.Column="3" Visibility="Collapsed" Background="{ThemeResource LayerFillColorAltBrush}" BorderThickness="1,0,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                <Pivot>
                    <PivotItem x:Name="PivotOutlineItem" Header="大纲">
                        <ListView x:Name="OutlineList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="OutlineList_ItemClick">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Display}" FontSize="12.5" Padding="4,3" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </PivotItem>
                    <PivotItem x:Name="PivotBacklinksItem" Header="反链">
                        <ListView x:Name="BacklinksList" SelectionMode="None" IsItemClickEnabled="True" ItemClick="BacklinksList_ItemClick">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Padding="4,6" Spacing="2">
                                        <TextBlock Text="{Binding SourceNoteTitle}" FontWeight="SemiBold" FontSize="12.5" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock Text="{Binding ContextSnippet}" FontSize="11.5" Opacity="0.65" MaxLines="2" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </PivotItem>
                    <PivotItem x:Name="PivotAttachItem" Header="附件">
                        <Grid RowSpacing="8" Padding="4,6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Button x:Name="AddAttachBtn" Content="+ 添加附件" HorizontalAlignment="Stretch" Click="AddAttachment_Click" />
                            <ListView x:Name="AttachmentsList" Grid.Row="1" SelectionMode="None" IsItemClickEnabled="True" ItemClick="AttachmentsList_ItemClick">
                                <ListView.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Padding="2,4">
                                            <TextBlock Text="{Binding FileName}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding MimeType}" FontSize="10.5" Opacity="0.5" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </Grid>
                    </PivotItem>
                </Pivot>
            </Grid>
        </Grid>

        <!-- ==================== Whisper-Quiet Status Bar with MS Word Stats Popover ==================== -->
        <Grid Grid.Row="2" Padding="12,0" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusLeftText" Text="全库加密 · 防崩溃保护已启用" FontSize="11" Opacity="0.6" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            <Button x:Name="VimModeQuickBtn"
                    Grid.Column="1"
                    Content="普通模式"
                    Click="QuickToggleVim_Click"
                    Padding="8,0"
                    Margin="0,0,8,0"
                    FontSize="11"
                    Opacity="0.72"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="点击一键切换「普通模式」与「Vim 模式」" />
            <!-- Clickable Microsoft Word-Style Word Count Button -->
            <Button x:Name="WordCountBtn"
                    Grid.Column="2"
                    Content="0 字"
                    Padding="8,0"
                    FontSize="11"
                    Opacity="0.75"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="点击查看 Microsoft Word 标准详细字数统计">
                <Button.Flyout>
                    <Flyout x:Name="WordCountFlyout">
                        <StackPanel Width="280" Spacing="8">
                            <TextBlock x:Name="WcTitleText" Text="字数统计（Microsoft Word 标准）" FontWeight="SemiBold" FontSize="13.5" />
                            <Border Height="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
                            <Grid RowSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="WcLblTotal" Grid.Row="0" Grid.Column="0" Text="总字数（Word 标准）" FontWeight="SemiBold" FontSize="12.5" />
                                <TextBlock x:Name="WcValTotal" Grid.Row="0" Grid.Column="1" Text="0" FontWeight="Bold" FontSize="13" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />

                                <TextBlock x:Name="WcLblCjk" Grid.Row="1" Grid.Column="0" Text="中文 / 日韩字符" FontSize="12" Opacity="0.8" />
                                <TextBlock x:Name="WcValCjk" Grid.Row="1" Grid.Column="1" Text="0" FontSize="12" />

                                <TextBlock x:Name="WcLblLatin" Grid.Row="2" Grid.Column="0" Text="英文 / 数字词数" FontSize="12" Opacity="0.8" />
                                <TextBlock x:Name="WcValLatin" Grid.Row="2" Grid.Column="1" Text="0" FontSize="12" />

                                <TextBlock x:Name="WcLblNoSp" Grid.Row="3" Grid.Column="0" Text="字符数（不计空格）" FontSize="12" Opacity="0.8" />
                                <TextBlock x:Name="WcValNoSp" Grid.Row="3" Grid.Column="1" Text="0" FontSize="12" />

                                <TextBlock x:Name="WcLblSp" Grid.Row="4" Grid.Column="0" Text="字符数（计空格）" FontSize="12" Opacity="0.8" />
                                <TextBlock x:Name="WcValSp" Grid.Row="4" Grid.Column="1" Text="0" FontSize="12" />

                                <TextBlock x:Name="WcLblPara" Grid.Row="5" Grid.Column="0" Text="段落数" FontSize="12" Opacity="0.8" />
                                <TextBlock x:Name="WcValPara" Grid.Row="5" Grid.Column="1" Text="0" FontSize="12" />

                                <TextBlock x:Name="WcLblLines" Grid.Row="6" Grid.Column="0" Text="总行数" FontSize="12" Opacity="0.8" />
                                <TextBlock x:Name="WcValLines" Grid.Row="6" Grid.Column="1" Text="0" FontSize="12" />

                                <TextBlock x:Name="WcLblSel" Grid.Row="7" Grid.Column="0" Text="当前选中字数 / 字符" FontSize="12" Opacity="0.8" />
                                <TextBlock x:Name="WcValSel" Grid.Row="7" Grid.Column="1" Text="0 / 0" FontSize="12" />
                            </Grid>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- ==================== Local App Lock Overlay ==================== -->
        <Grid x:Name="AppLockOverlay" Grid.RowSpan="3" Visibility="Collapsed" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="320" Spacing="14" Padding="28" CornerRadius="14" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <FontIcon Glyph="&#xE72E;" FontSize="28" HorizontalAlignment="Center" />
                <TextBlock Text="MKNote Next 已锁定" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock x:Name="AppLockHintText" Text="本地加密校验" FontSize="12" Opacity="0.6" HorizontalAlignment="Center" />
                <PasswordBox x:Name="AppLockPwdBox" PlaceholderText="输入主密码解锁" />
                <Button Content="解锁" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="UnlockApp_Click" />
                <Button x:Name="HelloUnlockBtn" Content="使用 Windows Hello 解锁" HorizontalAlignment="Stretch" Click="UnlockAppWithHello_Click" />
                <TextBlock x:Name="AppLockErrText" Foreground="IndianRed" FontSize="12" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
