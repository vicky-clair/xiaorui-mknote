<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MKNote.App.Views.MarkdownGuideWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Markdown 语法与快捷键指南 — MKNote Next">

    <Grid x:Name="RootGrid" Padding="20,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock x:Name="HeaderTitle" Text="Markdown 语法速查与快捷键自定义" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="HeaderDesc"
                       Text="支持双向链接、提示卡、数学公式与流程图语法。您可以修改可编辑项的快捷键（须含 Ctrl/Alt），应用固定保留快捷键受系统保护禁止修改。"
                       FontSize="12" Opacity="0.65" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="FilterBox" Grid.Column="0" PlaceholderText="搜索语法、快捷键或功能说明..." TextChanged="FilterBox_TextChanged" />
            <ComboBox x:Name="CategoryFilterBox" Grid.Column="1" Width="180" SelectedIndex="0" SelectionChanged="CategoryFilterBox_SelectionChanged">
                <ComboBoxItem Content="全部分类" />
                <ComboBoxItem Content="标题与结构" />
                <ComboBoxItem Content="行内样式" />
                <ComboBoxItem Content="代码块与列表" />
                <ComboBoxItem Content="双链与进阶语法" />
                <ComboBoxItem Content="固定快捷键（不可修改）" />
            </ComboBox>
        </Grid>

        <Border Grid.Row="2" BorderThickness="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Padding="12,8" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Background="{ThemeResource LayerFillColorAltBrush}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="功能" FontSize="12" FontWeight="SemiBold" Opacity="0.7" />
                    <TextBlock Grid.Column="1" Text="Markdown 语法" FontSize="12" FontWeight="SemiBold" Opacity="0.7" />
                    <TextBlock Grid.Column="2" Text="说明" FontSize="12" FontWeight="SemiBold" Opacity="0.7" />
                    <TextBlock Grid.Column="3" Text="默认快捷键" FontSize="12" FontWeight="SemiBold" Opacity="0.7" />
                    <TextBlock Grid.Column="4" Text="自定义快捷键" FontSize="12" FontWeight="SemiBold" Opacity="0.7" />
                </Grid>

                <ListView x:Name="ShortcutsList" Grid.Row="1" SelectionMode="None" Padding="4">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8,6" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="140" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Border Grid.Column="1" Background="{ThemeResource ControlFillColorSecondaryBrush}" CornerRadius="4" Padding="6,3" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Syntax}" FontFamily="Consolas" FontSize="11.5" TextWrapping="Wrap" />
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding Description}" FontSize="12" Opacity="0.8" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="3" Text="{Binding DefaultShortcut}" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center" Opacity="0.85" />
                                <TextBox Grid.Column="4"
                                         Text="{Binding CustomShortcut, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding Editable}"
                                         PlaceholderText="{Binding Placeholder}"
                                         FontFamily="Consolas"
                                         FontSize="12" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="恢复默认快捷键" Click="ResetDefaults_Click" />
                <TextBlock x:Name="ValidationMsg" Foreground="IndianRed" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="460" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="取消" Click="Cancel_Click" />
                <Button Content="保存并立即生效" Style="{StaticResource AccentButtonStyle}" Click="Save_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
