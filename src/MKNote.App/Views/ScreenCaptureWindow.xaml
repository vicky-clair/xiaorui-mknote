<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MKNote.App.Views.ScreenCaptureWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="区域截图">

    <Grid x:Name="OverlayRoot"
          Background="Black"
          KeyDown="OverlayRoot_KeyDown"
          PointerPressed="OverlayRoot_PointerPressed"
          PointerMoved="OverlayRoot_PointerMoved"
          PointerReleased="OverlayRoot_PointerReleased">

        <!-- Frozen full-screen snapshot (in-memory only) -->
        <Image x:Name="SnapshotImage" Stretch="Fill" />

        <!-- Translucent dark scrim -->
        <Rectangle Fill="#66000000" IsHitTestVisible="False" />

        <!-- Selection canvas -->
        <Canvas x:Name="SelectionCanvas" IsHitTestVisible="False">
            <Border x:Name="SelectionRect"
                    Visibility="Collapsed"
                    BorderBrush="#38BDF8"
                    BorderThickness="2"
                    Background="#2238BDF8" />
            <Border x:Name="InfoBadge"
                    CornerRadius="6"
                    Padding="10,5"
                    Background="#CC111827"
                    Canvas.Left="24"
                    Canvas.Top="24">
                <TextBlock x:Name="InfoText"
                           Text="拖拽鼠标框选任意截图区域 · 松开自动加密插入当前笔记 · 按 Esc 或右键取消"
                           Foreground="White"
                           FontSize="13"
                           FontWeight="SemiBold" />
            </Border>
        </Canvas>
    </Grid>
</Window>
