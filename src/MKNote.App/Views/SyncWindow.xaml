<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MKNote.App.Views.SyncWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="端到端加密同步（群晖 NAS / WebDAV）— MKNote Next">

    <Grid x:Name="RootGrid" Padding="20,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Text="端到端加密同步（AES-256-GCM · 支持群晖 Synology NAS / WebDAV）" FontSize="18" FontWeight="SemiBold" />
            <TextBlock Text="所有笔记正文、截图、图片与附件在离开本机前均经 AES-256-GCM 加密，群晖 NAS / WebDAV 仅存储密文，支持增量极速同步与冲突副本自动保留。"
                       FontSize="12" Opacity="0.68" TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="0.85*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Sync Settings Form -->
            <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10" Padding="0,0,8,0">
                    <ComboBox x:Name="ProviderCombo" Header="同步方式" HorizontalAlignment="Stretch" SelectionChanged="ProviderCombo_SelectionChanged">
                        <ComboBoxItem Tag="SynologyWebDav" Content="群晖 Synology NAS — WebDAV Server（推荐，内外网通用）" />
                        <ComboBoxItem Tag="SynologySmb" Content="群晖 Synology NAS — SMB 局域网共享目录（局域网极速直连）" />
                        <ComboBoxItem Tag="GenericWebDav" Content="通用 WebDAV 服务器 / 云盘" />
                        <ComboBoxItem Tag="LocalFolder" Content="本地目录 / 移动存储同步目录" />
                    </ComboBox>

                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="EndpointBox" Grid.Column="0" Header="服务器地址 / 共享目录路径" PlaceholderText="https://192.168.1.100:5006 或 \\192.168.1.100\MKNoteSync" />
                        <Button x:Name="BrowseFolderBtn" Grid.Column="1" Content="浏览..." VerticalAlignment="Bottom" Click="BrowseFolder_Click" Visibility="Collapsed" />
                    </Grid>

                    <TextBox x:Name="RemotePathBox" Header="远端同步子目录（WebDAV）" PlaceholderText="/homes/username/MKNoteSync 或 /MKNoteSync" />

                    <Grid x:Name="WebDavAuthPanel" ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="UsernameBox" Grid.Column="0" Header="账号 (DSM / WebDAV 用户名)" PlaceholderText="用户名" />
                        <PasswordBox x:Name="PasswordBox" Grid.Column="1" Header="密码 / 应用专用密码（加密保存）" PlaceholderText="密码" />
                    </Grid>

                    <CheckBox x:Name="SelfSignedCertCheck" Content="允许局域网自签名 HTTPS 证书（仅限 192.168.x.x / 10.x / .local 等私网地址，公网仍强制校验证书）" IsChecked="False" />

                    <Border Padding="12" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Background="{ThemeResource LayerFillColorAltBrush}">
                        <StackPanel Spacing="8">
                            <ToggleSwitch x:Name="E2eeToggle" Header="启用端到端加密 (E2EE · AES-256-GCM)" IsOn="True" OnContent="已开启（强推荐，远端零明文）" OffContent="已关闭" />
                            <PasswordBox x:Name="E2eePassBox" Header="端到端加密同步主密码（多台电脑必须一致）" PlaceholderText="设置同步加密主密码（本地 DPAPI 加密保存）" />
                        </StackPanel>
                    </Border>

                    <StackPanel Spacing="4">
                        <ComboBox x:Name="SyncModeCombo" Header="同步与备份策略" HorizontalAlignment="Stretch" SelectionChanged="SyncModeCombo_SelectionChanged">
                            <ComboBoxItem Tag="Bidirectional" Content="🔄 双向同步（推荐 · 同步删除且不复活，冲突保留副本）" />
                            <ComboBoxItem Tag="MergeKeepBoth" Content="➕ 保留两者（只增不删 · 两端合并，不删除远端文件）" />
                            <ComboBoxItem Tag="LocalMaster" Content="📤 以本地为主（单向镜像备份 · 本地覆盖远端并清理多余文件）" />
                            <ComboBoxItem Tag="RemoteMaster" Content="📥 以远端为主（从云端恢复 · 远端覆盖本地，不修改远端）" />
                        </ComboBox>
                        <TextBlock x:Name="SyncModeHintText" FontSize="11.5" Opacity="0.68" TextWrapping="Wrap" />
                    </StackPanel>

                    <ComboBox x:Name="AutoSyncCombo" Header="后台定时自动同步" HorizontalAlignment="Stretch">
                        <ComboBoxItem Tag="0" Content="仅手动同步" />
                        <ComboBoxItem Tag="5" Content="每 5 分钟自动加密同步" />
                        <ComboBoxItem Tag="15" Content="每 15 分钟自动加密同步" />
                        <ComboBoxItem Tag="30" Content="每 30 分钟自动加密同步" />
                        <ComboBoxItem Tag="60" Content="每 60 分钟自动加密同步" />
                    </ComboBox>
                </StackPanel>
            </ScrollViewer>

            <!-- Right: Step-by-Step Setup Guide (使用方法) -->
            <Border Grid.Column="1" Padding="14" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="📖 当前同步方式的使用方法" FontSize="14" FontWeight="SemiBold" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="GuideText" FontSize="12.5" LineHeight="22" TextWrapping="Wrap" IsTextSelectionEnabled="True" Opacity="0.88" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Fixed Always-Visible Status & Progress Banner (无需滚动即可实时看到传输进度与结果) -->
        <Border Grid.Row="2" Padding="12,9" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" Background="{ThemeResource LayerFillColorAltBrush}">
            <StackPanel Spacing="6">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SyncStatusText" Grid.Column="0" FontSize="12.5" TextWrapping="Wrap" Text="就绪：可先点击「测试连接」验证读写权限，再点击「立即加密同步」。" />
                    <TextBlock x:Name="SyncPercentText" Grid.Column="1" FontSize="12" FontWeight="SemiBold" Opacity="0.78" VerticalAlignment="Center" Visibility="Collapsed" />
                </Grid>
                <ProgressBar x:Name="SyncProgress" Minimum="0" Maximum="100" Value="0" IsIndeterminate="True" Visibility="Collapsed" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="3">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="TestConnBtn" Content="测试连接" Click="TestConnection_Click" />
                <Button x:Name="SyncNowBtn" Content="立即加密同步" Style="{StaticResource AccentButtonStyle}" Click="SyncNow_Click" />
                <Button x:Name="CancelSyncBtn" Content="取消" Click="CancelSync_Click" Visibility="Collapsed" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button x:Name="SaveCloseBtn" Content="保存配置并关闭" Click="SaveAndClose_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
